# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SECRET_KEY: Used to authenticate admin backend actions and simulate postbacks securely
ADMIN_SECRET_KEY="sweetcash_admin_secret_key_demo"

# OFFERWALL_POSTBACK_SECRET: Secret shared with offerwall providers (AdGem, OfferToro, etc.) for HMAC verification
OFFERWALL_POSTBACK_SECRET="sweetcash_postback_secret_key_prod"

# BOOTSTRAP_ADMIN_EMAIL: Initial admin email address with superuser permissions
BOOTSTRAP_ADMIN_EMAIL="mdfarukhossain8573@gmail.com"

